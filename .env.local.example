# ============================================================
# NEXARA — CONFIGURAÇÃO CENTRAL DE LINKS E CHAVES
# ============================================================
# Este é o único lugar onde você cola as suas keys reais.
# Copia este ficheiro para ".env.local" (sem o .example) e
# preenche cada valor. O ".env.local" NUNCA vai para o Git
# (já está no .gitignore) — é assim que se guarda segredo
# em projetos Next.js, nunca dentro do código.
#
# Depois de preencher ".env.local", quando publicar na Vercel,
# cola os mesmos valores em: Vercel > Project > Settings >
# Environment Variables.
# ============================================================

# --- SUPABASE (https://supabase.com/dashboard) ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta, só usada no servidor (nunca no browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- GOOGLE ADSENSE (site) ---
# https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- GOOGLE ADMOB (app futura) ---
# https://apps.admob.com
ADMOB_APP_ID=

# --- APPYPAY (https://appypay.co.ao) ---
# Só disponível depois da aprovação como comerciante (precisa do NIF empresarial)
APPYPAY_MERCHANT_ID=
APPYPAY_API_KEY=
APPYPAY_WEBHOOK_SECRET=

# --- DOMÍNIO / VERCEL ---
NEXT_PUBLIC_SITE_URL=https://nexara.co.ao

# --- CLOUDFLARE ---
# Configurado no painel da Cloudflare (DNS, WAF), não precisa de key aqui

# --- UPSTASH REDIS (rate limiting em produção) ---
# https://upstash.com — grátis até um certo volume. Sem isto, o rate
# limiting cai para memória local, que NÃO é fiável na Vercel (várias
# instâncias serverless não partilham memória entre si).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SEGREDO INTERNO (comunicação servidor-a-servidor) ---
# Protege a rota /api/compress, que só o próprio servidor deve chamar
# (nunca um cliente de fora). Gera um valor aleatório qualquer — por
# exemplo, no terminal: openssl rand -hex 32
INTERNAL_API_SECRET=
